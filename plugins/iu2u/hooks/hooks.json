{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "iu2u",
            "args": [
              "hook",
              "guard"
            ],
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "iu2u",
            "args": [
              "hook",
              "proof"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "iu2u",
            "args": [
              "hook",
              "trim"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "iu2u",
            "args": [
              "hook",
              "proof"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".+",
        "hooks": [
          {
            "type": "command",
            "command": "iu2u",
            "args": [
              "hook",
              "proof"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "iu2u",
            "args": [
              "hook",
              "compass"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "iu2u",
            "args": [
              "hook",
              "prune"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
